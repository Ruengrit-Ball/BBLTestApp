  "scripts": {
    "ios": "npx nx run mobile:run-ios",
    "android": "npx nx run mobile:run-android",
    "reinstall": "pnpm clean && pnpm i && pnpm pod-install",
    "clean-node": "rm -rf apps/mobile/node_modules/ && rm -rf node_modules/ && rm -f apps/mobile/node_modules && rm -f pnpm-lock.yaml",
    "clean-ios": "rm -rf ./apps/mobile/ios/build/ && rm -rf ./apps/mobile/ios/Pods/ && rm -f ./apps/mobile/ios/Podfile.lock",
    "clean-android": "rm -rf ./apps/mobile/android/app/build/ && rm -rf ./apps/mobile/android/.gradle/",
    "pod-install": "npx nx run mobile:pod-install",
    "start": "nx run @bbltest-app/mobile:start",
    "test": "nx run @bbltest-app/mobile:test",
    "lint": "nx run @bbltest-app/mobile:lint"
  },
  "private": true,
